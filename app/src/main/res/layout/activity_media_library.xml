<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yp_white"
    android:orientation="vertical">

    <TextView
        android:id="@+id/mediaLibraryTitle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin"
        android:text="@string/media_library"
        android:textColor="@color/yp_black"
        android:textSize="@dimen/header_title_size"
        android:textStyle="bold"
        android:translationY="@dimen/header_title_offset" />

</LinearLayout>