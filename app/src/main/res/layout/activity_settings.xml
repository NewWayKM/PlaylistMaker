<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <!-- Верхняя панель -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="@dimen/settings_back_icon_size"
            android:layout_height="@dimen/settings_back_icon_size"
            android:contentDescription="@string/back_button_description"
            android:src="@drawable/ic_arrow_back"
            android:translationY="@dimen/header_title_offset"
            app:tint="@color/primary_text" />

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/header_title_margin_start"
            android:text="@string/settings_title"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/header_title_size"
            android:textStyle="bold"
            android:translationY="@dimen/header_title_offset" />

    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_rows_top_spacing" />

    <!-- Тёмная тема -->

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/darkThemeSwitch"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_row_height"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin"
        android:text="@string/dark_theme"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/settings_text_size" />

    <!-- Поделиться приложением -->

    <TextView
        android:id="@+id/shareAppRow"
        style="@style/SettingsRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_row_height"
        android:text="@string/share_app"
        app:drawableEndCompat="@drawable/ic_share"
        app:drawableTint="@color/yp_gray" />

    <!-- Написать в поддержку -->

    <TextView
        android:id="@+id/supportRow"
        style="@style/SettingsRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_row_height"
        android:text="@string/write_to_support"
        app:drawableEndCompat="@drawable/ic_help_group"
        app:drawableTint="@color/yp_gray" />

    <!-- Пользовательское соглашение -->

    <TextView
        android:id="@+id/userAgreementRow"
        style="@style/SettingsRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_row_height"
        android:text="@string/user_agreement"
        app:drawableEndCompat="@drawable/ic_arrow_right"
        app:drawableTint="@color/yp_gray" />

</LinearLayout>