<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yp_white"
    android:orientation="vertical">

    <!-- Верхняя панель -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="@dimen/settings_back_icon_size"
            android:layout_height="@dimen/settings_back_icon_size"
            android:contentDescription="@string/back_button_description"
            android:src="@drawable/ic_arrow_back"
            android:translationY="@dimen/header_title_offset"
            app:tint="@color/yp_black" />

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/header_title_margin_start"
            android:text="@string/settings_title"
            android:textColor="@color/yp_black"
            android:textSize="@dimen/header_title_size"
            android:textStyle="bold"
            android:translationY="@dimen/header_title_offset" />

    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_rows_top_spacing" />

    <!-- Тёмная тема -->

    <LinearLayout
        android:id="@+id/darkThemeRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_row_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dark_theme"
            android:textColor="@color/yp_black"
            android:textSize="@dimen/settings_text_size" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/darkThemeSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- Поделиться приложением -->

    <LinearLayout
        android:id="@+id/shareAppRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_row_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/share_app"
            android:textColor="@color/yp_black"
            android:textSize="@dimen/settings_text_size" />

        <ImageView
            android:layout_width="@dimen/settings_icon_size"
            android:layout_height="@dimen/settings_icon_size"
            android:contentDescription="@string/share_icon_description"
            android:src="@drawable/ic_share"
            app:tint="@color/yp_gray" />

    </LinearLayout>

    <!-- Написать в поддержку -->

    <LinearLayout
        android:id="@+id/supportRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_row_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/write_to_support"
            android:textColor="@color/yp_black"
            android:textSize="@dimen/settings_text_size" />

        <ImageView
            android:layout_width="@dimen/settings_icon_size"
            android:layout_height="@dimen/settings_icon_size"
            android:contentDescription="@string/support_icon_description"
            android:src="@drawable/ic_help_group"
            app:tint="@color/yp_gray" />

    </LinearLayout>

    <!-- Пользовательское соглашение -->

    <LinearLayout
        android:id="@+id/userAgreementRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_row_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/user_agreement"
            android:textColor="@color/yp_black"
            android:textSize="@dimen/settings_text_size" />

        <ImageView
            android:layout_width="@dimen/settings_icon_size"
            android:layout_height="@dimen/settings_icon_size"
            android:contentDescription="@string/agreement_icon_description"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/yp_gray" />

    </LinearLayout>

</LinearLayout>