<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/track_item_height">

    <ImageView
        android:id="@+id/trackCover"
        android:layout_width="@dimen/track_cover_size"
        android:layout_height="@dimen/track_cover_size"
        android:layout_marginStart="@dimen/track_item_start_margin"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/trackName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/track_cover_text_margin"
        android:layout_marginTop="@dimen/track_name_top_margin"
        android:ellipsize="end"
        android:fontFamily="@font/ys_display_regular"
        android:maxLines="1"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/track_name_text_size"
        app:layout_constraintEnd_toStartOf="@id/trackArrow"
        app:layout_constraintStart_toEndOf="@id/trackCover"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/trackInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/track_info_top_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@id/trackArrow"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@id/trackName"
        app:layout_constraintTop_toBottomOf="@id/trackName">

        <TextView
            android:id="@+id/artistName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/ys_display_regular"
            android:maxLines="1"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/track_info_text_size" />

        <FrameLayout
            android:layout_width="@dimen/track_info_dot_container_size"
            android:layout_height="@dimen/track_info_dot_container_size">

            <View
                android:layout_width="@dimen/track_info_dot_size"
                android:layout_height="@dimen/track_info_dot_size"
                android:layout_gravity="center"
                android:background="@drawable/track_info_dot" />

        </FrameLayout>

        <TextView
            android:id="@+id/trackTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/track_info_text_size" />

    </LinearLayout>

    <ImageView
        android:id="@+id/trackArrow"
        android:layout_width="@dimen/track_arrow_size"
        android:layout_height="@dimen/track_arrow_size"
        android:layout_marginEnd="@dimen/track_arrow_end_margin"
        android:contentDescription="@null"
        android:src="@drawable/ic_arrow_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>