<?xml version="1.0" encoding="utf-8"?>


<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <!-- 1. Верхняя панель -->
    <!-- Содержит кнопку «Назад» и заголовок «Поиск» -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin">

        <!-- 1.1. Кнопка возврата на предыдущий экран -->
        <ImageView
            android:id="@+id/backButton"
            android:layout_width="@dimen/settings_back_icon_size"
            android:layout_height="@dimen/settings_back_icon_size"
            android:contentDescription="@string/back_button_description"
            android:src="@drawable/ic_arrow_back"
            android:translationY="@dimen/header_title_offset"
            app:tint="@color/primary_text" />

        <!-- 1.2. Заголовок экрана «Поиск» -->
        <TextView
            android:id="@+id/searchTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/header_title_margin_start"
            android:fontFamily="@font/ys_display_medium"
            android:text="@string/search"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/header_title_size"
            android:translationY="@dimen/header_title_offset" />
    </LinearLayout>

    <!-- 2. Поле поискового запроса -->
    <!-- Содержит поле ввода и кнопку очистки-->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_field_height"
        android:layout_marginStart="@dimen/screen_horizontal_margin"
        android:layout_marginTop="@dimen/search_field_margin_top"
        android:layout_marginEnd="@dimen/screen_horizontal_margin">

        <!-- 2.1. Поле ввода названия трека или исполнителя -->
        <!-- imeOptions="actionDone" — кнопка «Готово» на клавиатуре -->
        <!-- singleLine="true" — ввод текста в одну строку -->
        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/search_field_background"
            android:drawablePadding="@dimen/search_clear_margin_end"
            android:fontFamily="@font/ys_display_regular"
            android:hint="@string/search"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:paddingStart="@dimen/search_clear_margin_end"
            android:paddingEnd="@dimen/search_field_padding_end"
            android:textColor="@color/search_field_text"
            android:textColorHint="@color/search_field_hint"
            android:textSize="@dimen/search_field_text_size"
            app:drawableStartCompat="@drawable/ic_search"
            app:drawableTint="@color/yp_gray" />

        <!-- 2.2. Кнопка очистки введённого текста (крестик) -->
        <!-- Видимость управляется в SearchActivity.kt -->
        <ImageView
            android:id="@+id/clearButton"
            android:layout_width="@dimen/search_field_icon_size"
            android:layout_height="@dimen/search_field_icon_size"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/search_clear_margin_end"
            android:contentDescription="@string/clear_search_description"
            android:src="@drawable/ic_clear"
            app:tint="@color/yp_gray" />
    </FrameLayout>

    <!-- 3.Список треков -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tracksRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/track_list_margin_top"
        android:layout_weight="1" />

    <!-- 4. Пустой результат поиска -->
    <!-- Отображается, когда iTunes не нашёл треки -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

    <!-- 4.1. Изображение «Ничего не нашлось» -->
    <ImageView
        android:id="@+id/emptyStateImage"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_search_empty"
        android:contentDescription="@string/search_empty" />

    <!-- 4.2. Сообщение «Ничего не нашлось» -->
    <TextView
        android:id="@+id/emptyStateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ys_display_medium"
        android:text="@string/search_empty"
        android:textColor="@color/primary_text"
        android:textSize="19sp" />
    </LinearLayout>

    <!-- 5. Ошибка соединения с сервером -->
    <!-- Отображается при отсутствии интернета или ошибке запроса -->
    <LinearLayout
        android:id="@+id/errorState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin"
        android:visibility="gone">

        <!-- 5.1. Изображение «Проблемы со связью» -->
        <ImageView
            android:id="@+id/errorStateImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_search_error"
            android:contentDescription="@string/search_error" />

        <!-- 5.2. Заголовок ошибки -->
        <TextView
            android:id="@+id/errorStateText"
            android:layout_width="312dp"
            android:layout_height="wrap_content"
            android:minHeight="88dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/ys_display_regular"
            android:gravity="center_horizontal|top"
            android:text="@string/search_error_full"
            android:textColor="@color/primary_text"
            android:textSize="19sp"
            android:lineSpacingExtra="3sp"
            android:letterSpacing="0"
            android:includeFontPadding="false" />

        <!-- 5.3. Кнопка повторного запроса -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            style="@style/SearchRetryButton"
            android:layout_marginTop="@dimen/search_retry_margin_top"
            android:text="@string/search_retry" />
    </LinearLayout>

</LinearLayout>