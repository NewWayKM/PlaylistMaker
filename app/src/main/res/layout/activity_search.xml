<?xml version="1.0" encoding="utf-8"?>


<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">


    <!-- Верхняя панель -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="@dimen/settings_back_icon_size"
            android:layout_height="@dimen/settings_back_icon_size"
            android:contentDescription="@string/back_button_description"
            android:src="@drawable/ic_arrow_back"
            android:translationY="@dimen/header_title_offset"
            app:tint="@color/primary_text" />

        <TextView
            android:id="@+id/searchTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/header_title_margin_start"
            android:fontFamily="@font/ys_display_medium"
            android:text="@string/search"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/header_title_size"
            android:translationY="@dimen/header_title_offset" />

    </LinearLayout>

    <!-- Поле поискового запроса -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_field_height"
        android:layout_marginStart="@dimen/screen_horizontal_margin"
        android:layout_marginTop="@dimen/search_field_margin_top"
        android:layout_marginEnd="@dimen/screen_horizontal_margin">

        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/search_field_background"
            android:drawablePadding="@dimen/search_clear_margin_end"
            android:fontFamily="@font/ys_display_regular"
            android:hint="@string/search"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="@dimen/search_clear_margin_end"
            android:paddingEnd="@dimen/search_field_padding_end"
            android:textColor="@color/search_field_text"
            android:textColorHint="@color/search_field_hint"
            android:textSize="@dimen/search_field_text_size"
            app:drawableStartCompat="@drawable/ic_search"
            app:drawableTint="@color/yp_gray" />


        <ImageView
            android:id="@+id/clearButton"
            android:layout_width="@dimen/search_field_icon_size"
            android:layout_height="@dimen/search_field_icon_size"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/search_clear_margin_end"
            android:contentDescription="@string/clear_search_description"
            android:src="@drawable/ic_clear"
            app:tint="@color/yp_gray" />

    </FrameLayout>

</LinearLayout>