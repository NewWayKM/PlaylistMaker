<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- Кнопки главного экрана -->

    <style name="MainScreenButton"
        parent="Widget.MaterialComponents.Button.UnelevatedButton">


        <item name="android:fontFamily">@font/ys_display_medium</item>

        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/main_button_content</item>
        <item name="android:textSize">@dimen/main_button_text_size</item>

        <item name="backgroundTint">@color/main_button_background</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>

        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/button_icon_padding</item>
        <item name="iconSize">@dimen/button_icon_size</item>
        <item name="iconTint">@color/main_button_content</item>

    </style>

    <!-- Строки экрана настроек -->

    <style name="SettingsRow">
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/screen_horizontal_margin</item>
        <item name="android:paddingEnd">@dimen/screen_horizontal_margin</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">@dimen/settings_text_size</item>
    </style>

    <!-- Кнопка «Обновить» на экране ошибки поиска -->
    <style name="SearchRetryButton"
        parent="Widget.MaterialComponents.Button.UnelevatedButton">

        <!-- Размеры кнопки -->
        <item name="android:layout_width">@dimen/search_retry_width</item>
        <item name="android:layout_height">@dimen/search_retry_height</item>

        <!-- Шрифт и текст -->
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/search_retry_text_size</item>
        <item name="android:textColor">@color/search_retry_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0</item>

        <!-- Цвет фона и скругление -->
        <item name="backgroundTint">@color/search_retry_background</item>
        <item name="cornerRadius">@dimen/search_retry_corner_radius</item>

        <!-- Размеры и отступы -->
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>

    </style>

</resources>