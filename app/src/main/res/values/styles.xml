<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- 1. Главный экран -->
    <!-- 1.1 Кнопки главного экрана -->
    <style name="MainScreenButton"
        parent="Widget.MaterialComponents.Button.UnelevatedButton">

        <!-- 1.1.1 Шрифт и текст -->
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/main_button_content</item>
        <item name="android:textSize">@dimen/main_button_text_size</item>

        <!-- 1.1.2 Фон и скругление -->
        <item name="backgroundTint">@color/main_button_background</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>

        <!-- 1.1.3 Иконка -->
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/button_icon_padding</item>
        <item name="iconSize">@dimen/button_icon_size</item>
        <item name="iconTint">@color/main_button_content</item>
    </style>

    <!-- 2. Экран настроек -->
    <!-- 2.1 Строки экрана настроек -->
    <style name="SettingsRow">

        <!-- 2.1.1 Расположение и отступы -->
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/screen_horizontal_margin</item>
        <item name="android:paddingEnd">@dimen/screen_horizontal_margin</item>

        <!-- 2.1.2 Шрифт и текст -->
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">@dimen/settings_text_size</item>
    </style>

    <!-- 3. Экран поиска -->
    <!-- 3.1 Кнопка «Обновить» на экране ошибки поиска -->
    <style name="SearchRetryButton"
        parent="Widget.MaterialComponents.Button.UnelevatedButton">

        <!-- 3.1.1 Размеры кнопки -->
        <item name="android:layout_width">@dimen/search_retry_width</item>
        <item name="android:layout_height">@dimen/search_retry_height</item>

        <!-- 3.1.2 Шрифт и текст -->
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/search_retry_text_size</item>
        <item name="android:textColor">@color/search_retry_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0</item>

        <!-- 3.1.3 Цвет фона и скругление -->
        <item name="backgroundTint">@color/search_retry_background</item>
        <item name="cornerRadius">@dimen/search_retry_corner_radius</item>

        <!-- 3.1.4 Размеры и отступы -->
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <!-- 3.2 Кнопка очистки истории поиска -->
    <style name="SearchHistoryClearButton"
        parent="SearchRetryButton">

        <!-- 3.2.1 Размеры кнопки -->
        <item name="android:layout_width">@dimen/search_history_button_width</item>
        <item name="android:layout_height">@dimen/search_history_button_height</item>

        <!-- 3.2.2 Шрифт и текст -->
        <item name="android:textColor">@color/search_history_button_text</item>
        <item name="android:textSize">@dimen/search_history_button_text_size</item>
        <item name="android:lineHeight">16sp</item>
        <item name="android:singleLine">true</item>

        <!-- 3.2.3 Фон и скругление -->
        <item name="cornerRadius">@dimen/search_history_button_corner_radius</item>
        <item name="backgroundTint">@color/search_history_button_background</item>

        <!-- 3.2.4 Минимальные размеры, отступы -->
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

</resources>